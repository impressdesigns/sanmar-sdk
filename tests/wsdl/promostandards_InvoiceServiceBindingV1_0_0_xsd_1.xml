      <xsd:restriction base="xsd:string">
        <xsd:minLength value="2"></xsd:minLength>
        <xsd:maxLength value="2"></xsd:maxLength>
      </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
  <xsd:element name="orderedQuantity">
    <xsd:simpleType>
      <xsd:restriction base="xsd:decimal">
