        <xsd:maxLength value="64"></xsd:maxLength>
      </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
  <xsd:element name="taxType">
    <xsd:simpleType>
      <xsd:restriction base="ns2:taxTypeType">
        <xsd:minLength value="1"></xsd:minLength>
        <xsd:maxLength value="64"></xsd:maxLength>
      </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
  <xsd:element name="unitPrice">
    <xsd:simpleType>
      <xsd:restriction base="xsd:decimal">
        <xsd:fractionDigits value="4"></xsd:fractionDigits>
