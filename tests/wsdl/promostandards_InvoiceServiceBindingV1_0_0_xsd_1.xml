        <xsd:minLength value="2"></xsd:minLength>
      </xsd:restriction>
    </xsd:simpleType>
  </xsd:element>
  <xsd:element name="currency" type="ns4:CurrencyCodeType"></xsd:element>
  <xsd:element name="discountAmount">
