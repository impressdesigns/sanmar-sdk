  <xsd:element name="AccountInfo">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element ref="ns2:accountName" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:accountNumber" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:attentionTo" minOccurs="0"></xsd:element>
        <xsd:element name="Address1" type="ns2:addressLine" minOccurs="0"></xsd:element>
        <xsd:element name="Address2" type="ns2:addressLine" minOccurs="0"></xsd:element>
        <xsd:element name="Address3" type="ns2:addressLine" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:city" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:region" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:postalCode" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:country" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:email" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:phone" minOccurs="0"></xsd:element>
