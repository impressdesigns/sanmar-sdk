  <xsd:simpleType name="quantityUOMType">
    <xsd:restriction base="xsd:string">
      <xsd:enumeration value="BX"></xsd:enumeration>
      <xsd:enumeration value="CA"></xsd:enumeration>
      <xsd:enumeration value="DZ"></xsd:enumeration>
      <xsd:enumeration value="EA"></xsd:enumeration>
      <xsd:enumeration value="KT"></xsd:enumeration>
      <xsd:enumeration value="PR"></xsd:enumeration>
      <xsd:enumeration value="PK"></xsd:enumeration>
      <xsd:enumeration value="RL"></xsd:enumeration>
      <xsd:enumeration value="ST"></xsd:enumeration>
      <xsd:enumeration value="SL"></xsd:enumeration>
