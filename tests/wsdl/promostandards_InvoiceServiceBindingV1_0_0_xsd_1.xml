        <xsd:element ref="ns2:purchaseOrderLineItemNumber" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:orderedQuantity" minOccurs="0"></xsd:element>
        <xsd:element ref="ns2:invoiceQuantity"></xsd:element>
        <xsd:element ref="ns2:backOrderedQuantity" minOccurs="0"></xsd:element>
