<?xml version="1.0" encoding="UTF-8"?><!-- Published by JAX-WS RI at http://jax-ws.dev.java.net. RI's version is JAX-WS RI 2.1.4-b01-. --><xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:ns1="http://www.promostandards.org/WSDL/Invoice/1.0.0/" xmlns:ns2="http://www.promostandards.org/WSDL/Invoice/1.0.0/SharedObjects/" xmlns:ns4="http://www.isotc211.org/iso4217/" xmlns:ns5="http://www.codesynthesis.com/xmlns/xsstl" targetNamespace="http://www.promostandards.org/WSDL/Invoice/1.0.0/SharedObjects/" elementFormDefault="qualified">
  <xsd:import namespace="http://www.codesynthesis.com/xmlns/xsstl" schemaLocation="https://ws.sanmar.com:8080/promostandards/InvoiceServiceBindingV1_0_0?xsd=2"></xsd:import>
  <xsd:import namespace="http://www.isotc211.org/iso4217/" schemaLocation="https://ws.sanmar.com:8080/promostandards/InvoiceServiceBindingV1_0_0?xsd=3"></xsd:import>
