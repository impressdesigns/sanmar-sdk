      <xsd:enumeration value="SALES"></xsd:enumeration>
      <xsd:enumeration value="HST/GST"></xsd:enumeration>
      <xsd:enumeration value="PST"></xsd:enumeration>
      <xsd:enumeration value="VAT"></xsd:enumeration>
